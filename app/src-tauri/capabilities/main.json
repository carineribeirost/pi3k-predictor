{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: core, logging, and app commands only",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:default",
    "log:default",
    "allow-app-info",
    "allow-model-status",
    "allow-reference-data",
    "allow-create-run",
    "allow-predict-chunk",
    "allow-predict-one",
    "allow-list-runs",
    "allow-get-run",
    "allow-get-run-rows",
    "allow-rename-run",
    "allow-set-run-threshold",
    "allow-delete-run",
    "allow-export-run"
  ]
}
